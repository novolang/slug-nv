        ("Straße naïve\tМосква (Crème — Москва...Łódź",
        "strasse-naive-moskva-creme-moskva-lodz"),
        ("Kraków книга Zürich...Kraków: Straße) hello _ ",
        "krakow-kniga-zurich-krakow-strasse-hello"),
        ("brûlée C – Škoda; Straße", "brulee-c-skoda-strasse"),
        ("über'Zürich'Paulo Café (Paulo * Kraków ", "uber-zurich-paulo-cafe-paulo-krakow"),
        ("piñata! ", "pinata"),
        ("x86_64 / piñata _ Paulo", "x86-64-pinata-paulo"),
        ("Café\" release - 0.13; Łódź", "cafe-release-0-13-lodz"),
        ("Škoda (naïve\tx86_64 - IPv6. ", "skoda-naive-x86-64-ipv6"),
        ("été\" œuvre. C * piñata Москва'jalapeño", "ete-oeuvre-c-pinata-moskva-jalapeno"),
        ("naïve — œuvre! Kraków; Café * Paulo? œuvre", "naive-oeuvre-krakow-cafe-paulo-oeuvre"),
        ("brûlée * jalapeño", "brulee-jalapeno"),
        ("hello, brûlée! v2'Novo? Łódź ", "hello-brulee-v2-novo-lodz"),
        ("Škoda", "skoda"),
        ("jalapeño? Škoda? Straße (Paulo? Москва", "jalapeno-skoda-strasse-paulo-moskva"),
        ("Αθήνα  ", "athena"),
        ("façade (Café) Αθήνα\tC _ Ελλάδα - ", "facade-cafe-athena-c-ellada"),
        ("Café / release\" Ελλάδα, hello...Æsir", "cafe-release-ellada-hello-aesir"),
        ("Ελλάδα — Novo? São", "ellada-novo-sao"),
        ("jalapeño\" Ελλάδα'naïve \"été / œuvre", "jalapeno-ellada-naive-ete-oeuvre"),
        ("Łódź * Straße * naïve", "lodz-strasse-naive"),
        ("façade, Paulo", "facade-paulo")]

// python-slugify's defaults, as a policy.
fn plain() -> slugpolicy.SlugPolicy
    let u = slugpolicy.url_policy()
    SlugPolicy { separator: u.separator,
        case: u.case,
        mode: u.mode,
        max_len: 0,
        truncate: u.truncate,
        empty_fallback: u.empty_fallback,
        collapse_runs: u.collapse_runs,
        trim_separators: u.trim_separators,
        expand_symbols: false }

@test
fn test_every_row_agrees_with_python_slugify() [io]
    for row in rows()
        let (title, expected) = row
        test.case(title)
        test.assert_eq(slugmake.slugify(title, plain()).slug, expected)
