// slugtrans_tests.nv — the table, the tiers, and the policies.
//
// The character answers are the compiled table's, which are deunicode's
// with the overrides tools/trans_table.py names.  The suite asserts
// that a caller can ask, before trusting a slug, whether the loaded
// table covers the script a title is in.

use std.test
use std.list
use slugtrans
use slugpolicy

@test
fn test_the_compiled_tier_is_the_european_alphabets_and_says_so() [io]
    let t = slugtrans.latin_table()

    test.case("it names itself, for a log line")
    test.assert(t.name == "latin")

    test.case("Latin with diacritics, Greek and Cyrillic are in it")
    test.assert(slugtrans.covers(t, 0x00E9))
    test.assert(slugtrans.covers(t, 0x03B1))
    test.assert(slugtrans.covers(t, 0x0416))

    test.case("Kana and Han are not")
    test.assert(not slugtrans.covers(t, 0x3042))
    test.assert(not slugtrans.covers(t, 0x65E5))

    test.case("and an emoji never is, in any tier")
    test.assert(not slugtrans.covers(t, 0x1F389))

@test
fn test_script_of_answers_the_tier_question_rather_than_the_unicode_one() [io]
    test.case("ASCII is its own answer, because it needs no transliteration")
    match slugtrans.script_of(97)
        SlugScriptAscii => test.assert(true)
        _               => test.assert(false)

    test.case("Latin-1 Supplement and Latin Extended-A are one answer: two blocks, one tier")
    match slugtrans.script_of(0x00E9)
        SlugScriptLatin => test.assert(true)
        _               => test.assert(false)
    match slugtrans.script_of(0x0142)
        SlugScriptLatin => test.assert(true)
        _               => test.assert(false)

    test.case("an emoji has nothing to transliterate to, ever")
    match slugtrans.script_of(0x1F389)
        SlugScriptNone => test.assert(true)
        _              => test.assert(false)

    test.case("script_is_compiled is how a caller knows which tier it needs")
    test.assert(slugtrans.script_is_compiled(SlugScriptCyrillic))
    test.assert(not slugtrans.script_is_compiled(SlugScriptHan))

@test
fn test_a_character_maps_to_a_string_because_one_letter_is_sometimes_two() [io]
    let t = slugtrans.latin_table()

    test.case("sharp s is two letters")
    test.assert(slugtrans.char_ascii(t, 0x00DF) == "ss")

    test.case("ash is two letters")
    test.assert(slugtrans.char_ascii(t, 0x00E6) == "ae")

    test.case("a Cyrillic yu is two letters, and keeps its case")
    test.assert(slugtrans.char_ascii(t, 0x042E) == "Yu")

    test.case("the numero sign is two letters and is not a letter at all")
    test.assert(slugtrans.char_ascii(t, 0x2116) == "No")

    test.case("and a character the table does not know answers the empty string")
    test.assert(slugtrans.char_ascii(t, 0x65E5) == "")

@test
fn test_transliteration_alone_is_published_for_callers_that_want_no_slug() [io]
    let t = slugtrans.latin_table()

    test.case("a whole string, with no policy applied — case, spaces and punctuation stay")
    test.assert(slugtrans.transliterate(t, "Café Münster!") == "Cafe Munster!")

    test.case("uncovered characters are dropped, and counted separately")
    test.assert(slugtrans.transliterate(t, "日本 Novo") == " Novo")
    test.assert(slugtrans.uncovered_count(t, "日本 Novo") == 2)

    test.case("a fully covered string has no uncovered characters")
    test.assert(slugtrans.uncovered_count(t, "Café") == 0)

    test.case("the buffer form appends")
    var seed: [u8] = [62]
    let out = slugtrans.transliterate_into(seed, t, "Café")
    test.assert(out[0] == 62)
    test.assert(list.len(out) > 1)

@test
fn test_the_extended_table_arrives_as_bytes_because_a_core_package_reads_nothing() [io]
    test.case("a blob that is not one answers None rather than a half-built table")
    let junk: [u8] = [1, 2, 3]
    test.assert(slugtrans.table_from_bytes(junk) == None)

    test.case("what pack_bytes wrote, table_from_bytes reads back")
    var empty: [u8] = []
    let blob = slugtrans.pack_bytes(empty, slugtrans.latin_table())
    match slugtrans.table_from_bytes(blob)
        None    => test.assert(false)
        Some(t) => test.assert(t.name == "latin")

@test
fn test_the_symbol_words_are_data_because_they_are_a_language_decision() [io]
    let en = slugtrans.word_substitutions()

    test.case("the English list has the ampersand as `and`")
    var saw = ""
    for pair in en
        if pair.0 == 38
            saw = pair.1
    test.assert(saw == "and")

    test.case("the German list has it as `und`, which is why this is not in the table")
    var de_word = ""
    for pair in slugtrans.word_substitutions_for("de")
        if pair.0 == 38
            de_word = pair.1
    test.assert(de_word == "und")

    test.case("a language this release has no list for falls back to English")
    var fallback = ""
    for pair in slugtrans.word_substitutions_for("qq")
        if pair.0 == 38
            fallback = pair.1
    test.assert(fallback == "and")

@test
fn test_the_named_policies_differ_in_the_fields_they_claim_to() [io]
    let gh = slugpolicy.github_policy()
    let urlp = slugpolicy.url_policy()
    let uni = slugpolicy.unicode_policy()

    test.case("all three lower-case and hyphenate")
    test.assert(gh.separator == "-")
    test.assert(urlp.separator == "-")
    match gh.case
        SlugCaseLower => test.assert(true)
        _             => test.assert(false)

    test.case("github has no length limit and no symbol expansion, because GitHub has neither")
    test.assert(gh.max_len == 0)
    test.assert(not gh.expand_symbols)

    test.case("url_policy has both")
    test.assert(urlp.max_len == 80)
    test.assert(urlp.expand_symbols)

    test.case("only the unicode policy keeps non-ASCII letters")
    match uni.mode
        SlugModeUnicode => test.assert(true)
        _               => test.assert(false)
    match urlp.mode
        SlugModeAscii => test.assert(true)
        _             => test.assert(false)

    test.case("no policy has an empty fallback")
    test.assert(gh.empty_fallback != "")
    test.assert(urlp.empty_fallback != "")
    test.assert(uni.empty_fallback != "")

@test
fn test_a_policy_can_be_compared_before_a_migration_moves_every_url() [io]
    let urlp = slugpolicy.url_policy()

    test.case("a policy equals itself")
    test.assert(slugpolicy.same_output(urlp, urlp))

    test.case("a different separator is a different output")
    test.assert(not slugpolicy.same_output(urlp, slugpolicy.with_separator(urlp, "_")))

    test.case("two policies with no limit agree")
    test.assert(slugpolicy.same_output(slugpolicy.with_max_len(urlp, 0),
                                       slugpolicy.with_max_len(urlp, 0)))

    test.case("with_max_len changes the one field and nothing else")
    let limited = slugpolicy.with_max_len(urlp, 40)
    test.assert(limited.max_len == 40)
    test.assert(limited.separator == urlp.separator)
