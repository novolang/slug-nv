// slugroute.nv — the two facts a slug generator cannot know, and the
// calls that ask for them.
//
// A slug is not a function of the title alone.  Two facts are missing,
// and both live in a database this package cannot reach.
//
// A slug is reserved when the route table already mounts that word:
// `/new`, `/edit`, `/admin`, `/api`, `/login`, `/sitemap.xml`, and
// whatever else the application mounted.  A post titled "New" slugs to
// `new`, the router matches the literal route first, and the post is
// unreachable.  A slug is taken when another page already has it:
// `Hello, World!` and `hello world` both give `hello-world`.  Both
// facts arrive as `fn(Str) -> Bool` predicates the caller supplies,
// because a list this package shipped would be stale the day it
// published and wrong for every application that mounted one more
// route.
//
// A colliding slug takes `-2`, then `-3`, and so on.  The second
// occurrence is `-2` rather than `-1`, because the first has no suffix
// and a `-1` would imply a `-0`.  This is the numbering the project's
// Markdown renderer gives duplicate heading anchors.

use slugmake
use slugpolicy
use slugtrans

// A slug, what it cost, and what the route table did to it.
pub struct SlugResolved
    // The slug to publish. Usable, unreserved and untaken.
    slug: Str
    // Everything `slugmake` reported.
    notes: [slugmake.SlugNote]
    // The slug before the route table touched it — equal to `slug`
    // when nothing collided. Kept so a log line can say what moved.
    proposed: Str
    // The suffix that was appended, or 0 when none was.  Two and
    // upwards, since the first occurrence has none.
    suffix: Int
    // True when `proposed` was refused because a predicate called it
    // reserved rather than because something already had it.
    was_reserved: Bool

// The predicate a route table supplies: true when this slug is a word
// the application has already mounted.
//
// A type alias so the two predicates read differently at a call site,
// and so the doc comment has somewhere to live.
pub alias SlugReservedFn = fn(Str) -> Bool

// The predicate a store supplies: true when something already has this
// slug.
pub alias SlugTakenFn = fn(Str) -> Bool

// Slug a title and make it fit a route table.
//
// The call a site generator makes; everything else in this package is
// a piece of it.  The slug is made first.  When `reserved` or `taken`
// says it cannot be used, it is numbered from `-2` until neither does,
// and `was_reserved` says whether the reserved word was the reason.
//
// ```novo
// use slugpolicy
// use slugroute
//
// fn reserved(s: Str) -> Bool
//     s == "new" or s == "edit"
//
// fn taken(s: Str) -> Bool
//     false
//
// fn main() [io]
//     let r = slugroute.resolve("New", slugpolicy.url_policy(), reserved, taken)
//     println(r.slug)
// ```
pub fn resolve(title: Str, p: slugpolicy.SlugPolicy, reserved: SlugReservedFn,
               taken: SlugTakenFn) -> SlugResolved []
    resolve_with(title, p, slugtrans.latin_table(), reserved, taken)

// The same, with a table the caller loaded.
//
// ```novo
// use slugpolicy
// use slugroute
// use slugtrans
//
// fn free(s: Str) -> Bool
//     false
//
// fn main() [io]
//     println(slugroute.resolve_with("Café", slugpolicy.url_policy(), slugtrans.latin_table(), free, free).slug)   // cafe
// ```
pub fn resolve_with(title: Str, p: slugpolicy.SlugPolicy, t: slugtrans.SlugTable,
                    reserved: SlugReservedFn, taken: SlugTakenFn) -> SlugResolved []
    let o = slugmake.slugify_with(title, p, t)
    let was_reserved = reserved(o.slug)
    let (slug, suffix) = numbered(o.slug, p.separator, reserved, taken)
    SlugResolved { slug: slug,
        notes: o.notes[:],
        proposed: o.slug,
        suffix: suffix,
        was_reserved: was_reserved }

// Make an already-built slug unique against `taken`, without slugging
// anything.
//
// The call for a slug that came out of a database column or a person's
// own input, and the one a heading-anchor pass makes: it has the base
// from `slugmake.slugify` and only needs the numbering.
//
// ```novo
// use slugroute
//
// fn taken(s: Str) -> Bool
//     s == "intro"
//
// fn main() [io]
//     println(slugroute.unique("intro", "-", taken))   // intro-2
// ```
pub fn unique(slug: Str, separator: Str, taken: SlugTakenFn) -> Str []
    let (unique_slug, _) = unique_numbered(slug, separator, taken)
    unique_slug

// The same, answering which suffix it used, 0 when none was needed, so
// a caller can log that a title collided rather than discovering it
// from the URL.
//
// ```novo
// use slugroute
//
// fn taken(s: Str) -> Bool
//     s == "intro"
//
// fn main() [io]
//     println("${slugroute.unique_numbered("intro", "-", taken).1}")   // 2
// ```
pub fn unique_numbered(slug: Str, separator: Str, taken: SlugTakenFn) -> (Str, Int) []
    numbered(slug, separator, never, taken)

// The base slug and the suffix a numbered slug was built from:
// `("intro", 2)` for `intro-2`, and `("intro", 0)` for `intro`.
//
// The inverse of `unique`, for a caller reading a slug back, such as a
// redirect table deciding whether `intro-2` and `intro` are the same
// post.  A suffix is the separator and a number from 2 to 999 without
// a leading zero, so `novo-2026` ends in a year rather than a suffix.
//
// ```novo
// use slugroute
//
// println("${slugroute.split_suffix("intro-2", "-").1}")   // 2
// ```
pub fn split_suffix(slug: Str, separator: Str) -> (Str, Int) []
    if separator == ""
        return (slug, 0)
    let Some(at) = last_index(slug, separator) else return (slug, 0)
    let digits = str.slice(slug, at + str.len(separator), str.len(slug))
    let n = str.len(digits)
    if n == 0 or n > 3 or str.byte_at_or(digits, 0, 0) == '0' or not list.all(list.range(0, n), i => is_digit(str.byte_at_or(digits, i, 0)))
        return (slug, 0)
    let value = str.to_int(digits) ?? 0
    if value < 2
        return (slug, 0)
    (str.slice(slug, 0, at), value)

// Slug a sequence of titles against each other, the way a table of
// contents does: each one made unique against the ones before it, in
// document order.
//
// A separate call because the `taken` predicate for this case is the
// list itself, and a caller writing the loop would have to keep it.
//
// ```novo
// use slugpolicy
// use slugroute
//
// for s in slugroute.number_in_order(["Intro", "Intro", "Intro"],
//                                    slugpolicy.github_policy())
//     println(s)
// ```
pub fn number_in_order(titles: [Str], p: slugpolicy.SlugPolicy) -> [Str] []
    var seen: [Str] = []
    for title in titles
        let base = slugmake.slugify(title, p).slug
        var slug = base
        var k = 2
        for _ in 0..list.len(seen) + 1
            if not list.contains(seen, slug)
                break
            slug = base + p.separator + str.from_int(k)
            k = k + 1
        list.push(seen, slug)
    seen

// The route words a web application almost always has, as a list a
// caller can start from: `new`, `edit`, `delete`, `admin`, `api`,
// `login`, `logout`, `signup`, `search`, `static`, `assets`, `feed`,
// `rss`, `sitemap`, `robots`, `index`, `about`, `null`, `undefined`,
// `true`, `false`.
//
// A starting point and not the answer: the real set is whatever the
// application mounted, this package cannot know it, and a caller that
// used this list alone will still collide the first time somebody adds
// a route.  `reserved_in` turns it into a predicate for the caller that
// wants exactly this.
//
// ```novo
// use slugroute
//
// println("${list.len(slugroute.common_reserved())}")   // 21
// ```
pub fn common_reserved() -> [Str] []
    ["new",
        "edit",
        "delete",
        "admin",
        "api",
        "login",
        "logout",
        "signup",
        "search",
        "static",
        "assets",
        "feed",
        "rss",
        "sitemap",
        "robots",
        "index",
        "about",
        "null",
        "undefined",
        "true",
        "false"]

// Whether `slug` is in `words`: the predicate body a caller with a list
// rather than a query writes.
//
// ```novo
// use slugroute
//
// println("${slugroute.reserved_in(["new"], "new")}")   // true
// ```
pub fn reserved_in(words: [Str], slug: Str) -> Bool []
    list.contains(words, slug)

// Whether a slug is safe as a path segment: not empty, not `.` or
// `..`, and every ASCII character one RFC 3986 allows in a segment
// without escaping, less the percent sign.  A character outside ASCII
// is allowed, as RFC 3987 allows it in an IRI, since a Unicode slug is
// meant to keep its letters.
//
// ```novo
// use slugroute
//
// println("${slugroute.is_safe_segment("..")}")   // false
// ```
//
// The last check before a slug becomes a path, and it is separate from
// `slugpolicy.is_canonical` because the two ask different questions: a
// slug can be exactly what the policy produces and still be `..` if
// the policy's separator is `.`.
pub fn is_safe_segment(slug: Str) -> Bool []
    if slug == "" or slug == "." or slug == ".."
        return false
    list.all(list.range(0, str.len(slug)), i => segment_byte(str.byte_at_or(slug, i, 0)))

// Whether two slugs would collide in a route table that compares
// case-insensitively — which most filesystems do, and therefore most
// static sites.
//
// Published because a generator writing `Intro.html` and `intro.html`
// into one directory produces one file on macOS and two on Linux, and
// the failure appears only in deployment.  Two equal slugs are not a
// case collision; they are the same slug.
//
// ```novo
// use slugroute
//
// println("${slugroute.collides_on_case("Intro", "intro")}")   // true
// ```
pub fn collides_on_case(a: Str, b: Str) -> Bool []
    a != b and str.lower(a) == str.lower(b)

// A predicate that holds for nothing.
fn never(slug: Str) -> Bool
    false

// The first of `slug`, `slug-2`, `slug-3` and so on that neither
// predicate refuses, and the suffix used.
fn numbered(slug: Str, separator: Str, reserved: SlugReservedFn, taken: SlugTakenFn) -> (Str, Int)
    if not reserved(slug) and not taken(slug)
        return (slug, 0)
    var k = 2
    for _ in 0..1000000
        let candidate = slug + separator + str.from_int(k)
        if not reserved(candidate) and not taken(candidate)
            break
        k = k + 1
    (slug + separator + str.from_int(k), k)

fn is_digit(b: Int) -> Bool
    b >= '0' and b <= '9'

// The byte offset of the last occurrence of `sub` in `s`, or `None`.
fn last_index(s: Str, sub: Str) -> ?Int
    var found: ?Int = None
    var from = 0
    for _ in 0..str.len(s)
        match str.index_from(s, sub, from)
            None     =>
                break
            Some(at) =>
                found = Some(at)
                from = at + 1
    found

// Whether a byte may stand in a path segment unescaped: RFC 3986's
// unreserved characters, sub-delimiters, `:` and `@`, or any byte of a
// character outside ASCII.
fn segment_byte(b: Int) -> Bool
    b >= 0x80 or b >= 'a' and b <= 'z' or b >= 'A' and b <= 'Z' or b >= '0' and b <= '9' or str.contains("-._~!$&'()*+,;=:@", str.from_byte(b))
