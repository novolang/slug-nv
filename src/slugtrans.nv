// slugtrans.nv — the transliteration table, and where it stops.
//
// The table is this package's own, and it is tiered, for the same
// reason unicode-nv's is: the useful half is small and the complete
// half is large.  `deunicode`, itself derived from Perl's
// `Text::Unidecode`, covers essentially all of Unicode in about
// 500 KB, most of which is Han romanisation.  A site generator
// slugging English and Danish headings should not link 500 KB to turn
// `å` into `aa`.
//
// `latin_table()` is the compiled tier: Latin-1 Supplement, Latin
// Extended-A and -B, Latin Extended Additional, Greek and Coptic,
// Greek Extended, Cyrillic and its supplement, the combining marks,
// general punctuation, the currency signs and the letterlike symbols.
// Its answers are deunicode's, written into the table at the end of
// this file by `tools/trans_table.py`, with three sets of overrides:
// Danish and Norwegian `å` and `ø` are `aa` and `oe`, Russian follows
// the BGN/PCGN romanisation without its diacritics (`Ю` is `Yu`), and
// `№` is `No`.
//
// `table_from_bytes` is the rest: a table whose extra entries arrive
// as bytes the host read, because a `core` package reads no file.  A
// loaded table answers from its own entries first and from the
// compiled tier after.
//
// Han characters have no single romanisation: 行 is `xing` or `hang`
// in Mandarin depending on the word, and `gyou`, `kou` or `an` in
// Japanese.  `SlugScriptHan` is a script a caller can ask about before
// trusting a romanisation, and a CJK site probably wants
// `SlugModeUnicode` and a percent-encoded path instead.
//
// Transliteration is not normalisation.  A decomposed `é` reaches this
// table as `e` and U+0301, and the combining mark's answer is empty,
// so the result is the same `e` either way.

// The scripts the tables cover, so a caller can ask before it trusts
// the answer.
pub enum SlugScript
    // ASCII: no transliteration needed.
    SlugScriptAscii
    // Latin with diacritics — Latin-1 Supplement, Extended-A,
    // Extended-B, Extended Additional. In the compiled table.
    SlugScriptLatin
    // Greek and Coptic. In the compiled table.
    SlugScriptGreek
    // Cyrillic, including the Extended blocks. In the compiled table.
    SlugScriptCyrillic
    // Hebrew. Extended table only.
    SlugScriptHebrew
    // Arabic. Extended table only.
    SlugScriptArabic
    // Devanagari. Extended table only.
    SlugScriptDevanagari
    // Georgian and Armenian. Extended table only.
    SlugScriptCaucasus
    // Thai and Lao. Extended table only.
    SlugScriptThai
    // Hiragana, Katakana and the halfwidth forms. Extended table only.
    SlugScriptKana
    // Han. Extended table only, and see the module comment: the
    // romanisation is a guess, and this is the script for which the
    // guess is worst.
    SlugScriptHan
    // Emoji, symbols, private use — nothing to transliterate, ever.
    SlugScriptNone

// A loaded table.
//
// Holding it as a value rather than as a module-level constant is what
// lets a program choose its tier: a site generator for a Danish blog
// holds `latin_table()`, and the same binary serving a multilingual
// corpus holds the extended one.
pub struct SlugTable
    // Which scripts this table answers for, so `covers` is a lookup
    // rather than a probe.
    scripts: [SlugScript]
    // A short name for the tier, for a log line: `"latin"` or
    // `"full"`.
    name: Str
    // The table's own answers, as a codepoint and its ASCII, sorted by
    // codepoint.  Consulted before the compiled tier.  Empty for
    // `latin_table()`, whose answers are all compiled.
    entries: [(Int, Str)]

// The compiled-in table: Latin, Greek, Cyrillic. About 6 KB, and no
// host involved.
//
// ```novo
// use slugtrans
//
// let t = slugtrans.latin_table()
// println(t.name)   // latin
// ```
pub fn latin_table() -> SlugTable []
    SlugTable { scripts: [SlugScriptAscii, SlugScriptLatin, SlugScriptGreek, SlugScriptCyrillic],
        name: "latin",
        entries: [] }

// A table parsed out of bytes the host read.
//
// `None` when the blob is not one: a wrong magic, a truncated entry, a
// script code this release does not know, entries out of order, or
// bytes after the last entry.  The format is this package's own and
// `pack_bytes` writes it, so a build step can generate the blob from
// `deunicode`'s data and ship it beside the binary.
pub fn table_from_bytes(blob: [u8]) -> ?SlugTable []
    let n = list.len(blob)
    if n < 12 or not magic_ok(blob)
        return None
    let name_len = be(blob, 6, 2)
    var at = 8 + name_len
    if at + 2 > n
        return None
    var name_bytes: [Int] = []
    for i in 8..at
        list.push(name_bytes, blob[i] as Int)
    let script_count = be(blob, at, 2)
    at = at + 2
    if at + script_count + 4 > n
        return None
    var scripts: [SlugScript] = []
    for i in 0..script_count
        let Some(sc) = script_of_code(blob[at + i] as Int) else return None
        list.push(scripts, sc)
    at = at + script_count
    let entry_count = be(blob, at, 4)
    at = at + 4
    var entries: [(Int, Str)] = []
    var previous = -1
    for _ in 0..entry_count
        if at + 4 > n
            return None
        let ch = be(blob, at, 3)
        let len = blob[at + 3] as Int
        if ch <= previous or at + 4 + len > n
            return None
        var text: [Int] = []
        for i in at + 4..at + 4 + len
            list.push(text, blob[i] as Int)
        list.push(entries, (ch, bytes.byte_list_to_str(text)))
        previous = ch
        at = at + 4 + len
    if at != n
        return None
    Some(SlugTable { scripts: scripts, name: bytes.byte_list_to_str(name_bytes), entries: entries })

// Append a table's serialised form to `out`, for the build step that
// makes the blob.  `out` is written in place and answered.
//
// The form is the six bytes `SLUGT1`, the name's length in two bytes
// and the name in UTF-8, the script count in two bytes and one byte
// per script, the entry count in four bytes, and each entry as its
// codepoint in three bytes, the length of its answer in one byte and
// the answer.  Every number is big-endian.
pub fn pack_bytes(var out: [u8], t: SlugTable) -> [u8] []
    for b in MAGIC
        list.push(out, b as u8)
    let name = bytes.to_byte_list(bytes.from_str(t.name))
    put_be(out, list.len(name), 2)
    for b in name
        list.push(out, b)
    put_be(out, list.len(t.scripts), 2)
    for sc in t.scripts
        list.push(out, script_code(sc) as u8)
    put_be(out, list.len(t.entries), 4)
    for e in t.entries
        let (ch, text) = e
        let tb = bytes.to_byte_list(bytes.from_str(text))
        put_be(out, ch, 3)
        list.push(out, list.len(tb) as u8)
        for b in tb
            list.push(out, b)
    out

// Whether `t` has an answer for `ch`, from its own entries or from
// the compiled tier.  An answer may be empty: a combining mark is
// covered, and its answer is nothing.
//
// The check a caller makes before deciding whether a dropped character
// is a gap in the table or genuinely untransliterable.
pub fn covers(t: SlugTable, ch: Int) -> Bool []
    match lookup(t, ch)
        Some(_) => true
        None    => false

// Which script `ch` belongs to, for the purposes of this table.
//
// Coarser than a Unicode script property on purpose: the question this
// answers is "which tier do I need", and Latin Extended-B and Latin-1
// Supplement are one answer to that even though they are two blocks.
pub fn script_of(ch: Int) -> SlugScript []
    if ch < 0x80
        return SlugScriptAscii
    if in_ranges(ch, [0x0080, 0x024F, 0x1E00, 0x1EFF, 0x2C60, 0x2C7F, 0xA720, 0xA7FF])
        return SlugScriptLatin
    if in_ranges(ch, [0x0370, 0x03FF, 0x1F00, 0x1FFF])
        return SlugScriptGreek
    if in_ranges(ch, [0x0400, 0x052F, 0x1C80, 0x1C8F, 0x2DE0, 0x2DFF, 0xA640, 0xA69F])
        return SlugScriptCyrillic
    if in_ranges(ch, [0x0590, 0x05FF, 0xFB1D, 0xFB4F])
        return SlugScriptHebrew
    if in_ranges(ch, [0x0600, 0x06FF, 0x0750, 0x077F, 0x08A0, 0x08FF, 0xFB50, 0xFDFF, 0xFE70, 0xFEFF])
        return SlugScriptArabic
    if in_ranges(ch, [0x0900, 0x097F, 0xA8E0, 0xA8FF])
        return SlugScriptDevanagari
    if in_ranges(ch, [0x0530, 0x058F, 0x10A0, 0x10FF, 0x1C90, 0x1CBF, 0x2D00, 0x2D2F])
        return SlugScriptCaucasus
    if in_ranges(ch, [0x0E00, 0x0EFF])
        return SlugScriptThai
    if in_ranges(ch, [0x3040, 0x30FF, 0x31F0, 0x31FF, 0xFF65, 0xFF9F])
        return SlugScriptKana
    if in_ranges(ch, [0x3400, 0x4DBF, 0x4E00, 0x9FFF, 0xF900, 0xFAFF, 0x20000, 0x2FFFF])
        return SlugScriptHan
    SlugScriptNone

// Whether a script is in the compiled-in tier.
pub fn script_is_compiled(s: SlugScript) -> Bool []
    match s
        SlugScriptAscii    => true
        SlugScriptLatin    => true
        SlugScriptGreek    => true
        SlugScriptCyrillic => true
        _                  => false

// The ASCII for one character, or an empty string when the table has
// none.
//
// A `Str` rather than a byte because transliteration is not
// one-to-one: `ß` is `ss`, `æ` is `ae`, `Ю` is `Yu`, and `№` is `No`.
// A package whose table mapped a character to a character would have
// had to drop all four.
//
// ```novo
// use slugtrans
//
// println(slugtrans.char_ascii(slugtrans.latin_table(), 0x00DF))   // ss
// ```
pub fn char_ascii(t: SlugTable, ch: Int) -> Str []
    lookup(t, ch) ?? ""

// Transliterate a whole string, character by character, with
// uncovered characters dropped.
//
// The raw operation, without any of `slugmake`'s policy: no separator
// collapsing, no case forcing, no length limit. Published because a
// caller sometimes wants the transliteration and not the slug — a
// search index normalising its terms, a sort key for a list of names.
pub fn transliterate(t: SlugTable, text: Str) -> Str []
    var out: [u8] = []
    bytes.byte_list_to_str(transliterate_into(out, t, text))

// The same, appended to the caller's buffer, which is written in place
// and answered.
pub fn transliterate_into(var out: [u8], t: SlugTable, text: Str) -> [u8] []
    var i = 0
    let n = str.len(text)
    for _ in 0..n
        if i >= n
            break
        let ch = char_at(text, i)
        if ch < 0x80
            list.push(out, ch as u8)
        else
            for b in bytes.to_byte_list(bytes.from_str(lookup(t, ch) ?? ""))
                list.push(out, b)
        i = i + char_width(text, i)
    out

// How many characters of `text` this table has no answer for.
//
// The number behind `SlugNoteDropped`, and the one a site owner needs:
// a title that came out as three characters out of thirty did not
// slugify, it disappeared, and nobody finds out from the slug itself.
pub fn uncovered_count(t: SlugTable, text: Str) -> Int []
    var count = 0
    var i = 0
    let n = str.len(text)
    for _ in 0..n
        if i >= n
            break
        let ch = char_at(text, i)
        if ch >= 0x80 and lookup(t, ch) == None
            count = count + 1
        i = i + char_width(text, i)
    count

// The short-word substitutions `SlugPolicy.expand_symbols` applies, as
// pairs of a character and its word: `&` to `and`, `@` to `at`, `%` to
// `percent`, `+` to `plus`, `=` to `equals`, `#` to `number`, `$` to
// `dollar`, `<` to `less`, `>` to `greater`, and the currency signs.
//
// Published as DATA because it is a language decision rather than a
// script one — `&` is `und` in German — and a caller serving another
// language passes its own list to `slugmake.slugify_with_words`.
pub fn word_substitutions() -> [(Int, Str)] []
    words_for("en")

// The substitutions for a language named by its BCP 47 primary
// subtag, or the English list for a tag this release has none for.
//
// `de`, `fr`, `es`, `da` and `en`.  The primary subtag is matched
// case-insensitively, so `de-AT` and `DE` are German.
pub fn word_substitutions_for(language: Str) -> [(Int, Str)] []
    let primary = str.lower(str.split(language, "-")[0])
    words_for(primary)

// The magic that begins a serialised table: `SLUGT1`.
const MAGIC: [Int] = ['S', 'L', 'U', 'G', 'T', '1']

// The answer for `ch`, or `None` when the table has none.
//
// `char_ascii` answers the empty string for both an uncovered
// character and a covered one whose answer is nothing, such as a
// combining mark.  This call tells the two apart.
//
// ```novo
// use slugtrans
//
// println(slugtrans.char_ascii_of(slugtrans.latin_table(), 0x0301) ?? "none")   // (empty)
// ```
pub fn char_ascii_of(t: SlugTable, ch: Int) -> ?Str
    lookup(t, ch)

// The answer for `ch`: the table's own entry, then the compiled tier.
fn lookup(t: SlugTable, ch: Int) -> ?Str
    var lo = 0
    var hi = list.len(t.entries)
    for _ in 0..hi
        if lo >= hi
            break
        let mid = (lo + hi) / 2
        let (key, text) = t.entries[mid]
        if key == ch
            return Some(text)
        if key < ch
            lo = mid + 1
        else
            hi = mid
    compiled(ch)

// Whether `ch` falls in one of the inclusive ranges, given as pairs.
fn in_ranges(ch: Int, bounds: [Int]) -> Bool
    list.any(list.range(0, list.len(bounds) / 2), i => ch >= bounds[2 * i] and ch <= bounds[2 * i + 1])

// The byte a serialised table uses for a script.
fn script_code(sc: SlugScript) -> Int
    match sc
        SlugScriptAscii      => 0
        SlugScriptLatin      => 1
        SlugScriptGreek      => 2
        SlugScriptCyrillic   => 3
        SlugScriptHebrew     => 4
        SlugScriptArabic     => 5
        SlugScriptDevanagari => 6
        SlugScriptCaucasus   => 7
        SlugScriptThai       => 8
        SlugScriptKana       => 9
        SlugScriptHan        => 10
        SlugScriptNone       => 11

// The script a serialised table's byte stands for, or `None`.
fn script_of_code(code: Int) -> ?SlugScript
    match code
        0  => Some(SlugScriptAscii)
        1  => Some(SlugScriptLatin)
        2  => Some(SlugScriptGreek)
        3  => Some(SlugScriptCyrillic)
        4  => Some(SlugScriptHebrew)
        5  => Some(SlugScriptArabic)
        6  => Some(SlugScriptDevanagari)
        7  => Some(SlugScriptCaucasus)
        8  => Some(SlugScriptThai)
        9  => Some(SlugScriptKana)
        10 => Some(SlugScriptHan)
        11 => Some(SlugScriptNone)
        _  => None

// Whether a blob begins with the magic.
fn magic_ok(blob: [u8]) -> Bool
    list.all(list.range(0, list.len(MAGIC)), i => (blob[i] as Int) == MAGIC[i])

// A big-endian number of `width` bytes at `at`.
fn be(blob: [u8], at: Int, width: Int) -> Int
    list.fold(list.range(at, at + width), (n, i) => n * 256 + blob[i] as Int, 0)

// Append a big-endian number of `width` bytes.
fn put_be(var out: [u8], n: Int, width: Int)
    for k in 0..width
        list.push(out, (n >> (8 * (width - 1 - k))) & 0xFF as u8)

// The codepoint whose UTF-8 encoding starts at byte `i` of `text`.
//
// A byte that does not start a well-formed sequence is answered as
// itself, so a walk over malformed text still moves forward.  The
// table is keyed by codepoint, and this is how a caller walking a
// title reaches the key.
//
// ```novo
// use slugtrans
//
// println("${slugtrans.char_at("aé", 1)}")      // 233
// ```
pub fn char_at(text: Str, i: Int) -> Int
    let b = str.byte_at_or(text, i, 0)
    let width = char_width(text, i)
    if width == 1
        return b
    let lead = if width == 2
        b & 0x1F
    else
        if width == 3
            b & 0x0F
        else
            b & 0x07
    list.fold(list.range(i + 1, i + width), (cp, k) => cp * 64 + (str.byte_at_or(text, k, 0) & 0x3F), lead)

// How many bytes the character at byte `i` of `text` takes: the
// length its lead byte announces when the continuation bytes are
// there, and 1 for a byte that starts no well-formed sequence.
//
// ```novo
// use slugtrans
//
// println("${slugtrans.char_width("aé", 1)}")   // 2
// ```
pub fn char_width(text: Str, i: Int) -> Int
    let b = str.byte_at_or(text, i, 0)
    let want = if b >= 0xF0 and b < 0xF8
        4
    else
        if b >= 0xE0
            3
        else
            if b >= 0xC0
                2
            else
                1
    if want == 1 or b >= 0xF8
        return 1
    let ok = list.all(list.range(i + 1, i + want), k => (str.byte_at_or(text, k, 0) & 0xC0) == 0x80)
    if ok
        return want
    1

// The symbol words of a language, by its primary subtag.
fn words_for(language: Str) -> [(Int, Str)]
    match language
        "de" => [('&', "und"),
            ('@', "at"),
            ('%', "prozent"),
            ('+', "plus"),
            ('=', "gleich"),
            ('#', "nummer"),
            ('$', "dollar"),
            ('<', "kleiner"),
            ('>', "groesser"),
            (0x20AC, "euro"),
            (0x00A3, "pfund"),
            (0x00A5, "yen")]
        "fr" => [('&', "et"),
            ('@', "arobase"),
            ('%', "pourcent"),
            ('+', "plus"),
            ('=', "egal"),
            ('#', "numero"),
            ('$', "dollar"),
            ('<', "inferieur"),
            ('>', "superieur"),
            (0x20AC, "euro"),
            (0x00A3, "livre"),
            (0x00A5, "yen")]
        "es" => [('&', "y"),
            ('@', "arroba"),
            ('%', "por ciento"),
            ('+', "mas"),
            ('=', "igual"),
            ('#', "numero"),
            ('$', "dolar"),
            ('<', "menor"),
            ('>', "mayor"),
            (0x20AC, "euro"),
            (0x00A3, "libra"),
            (0x00A5, "yen")]
        "da" => [('&', "og"),
            ('@', "snabel a"),
            ('%', "procent"),
            ('+', "plus"),
            ('=', "lig med"),
            ('#', "nummer"),
            ('$', "dollar"),
            ('<', "mindre end"),
            ('>', "stoerre end"),
            (0x20AC, "euro"),
            (0x00A3, "pund"),
            (0x00A5, "yen")]
        _    => [('&', "and"),
            ('@', "at"),
            ('%', "percent"),
            ('+', "plus"),
            ('=', "equals"),
            ('#', "number"),
            ('$', "dollar"),
            ('<', "less"),
            ('>', "greater"),
            (0x20AC, "euro"),
            (0x00A3, "pound"),
            (0x00A5, "yen")]

// The compiled table.
//
// Written by tools/trans_table.py from deunicode 1.6.0, with the
// overrides that script names.  1696 characters.

const COMPILED: Int = 1696

// The compiled answer for `ch`, or `None` for a character the
// compiled tier does not cover.
fn compiled(ch: Int) -> ?Str
    match ch
        0xa0   => Some(" ")
        0xa1   => Some("!")
        0xa2   => Some("C/")
        0xa3   => Some("PS")
        0xa4   => Some("\$?")
        0xa5   => Some("Y=")
        0xa6   => Some("|")
        0xa7   => Some("SS")
        0xa8   => Some("\"")
        0xa9   => Some("(c)")
        0xaa   => Some("a")
        0xab   => Some("<<")
        0xac   => Some("!")
        0xad   => Some("")
        0xae   => Some("(r)")
        0xaf   => Some("-")
        0xb0   => Some("deg")
        0xb1   => Some("+-")
        0xb2   => Some("2")
        0xb3   => Some("3")
        0xb4   => Some("'")
        0xb5   => Some("u")
        0xb6   => Some("P")
        0xb7   => Some("*")
        0xb8   => Some(",")
        0xb9   => Some("1")
        0xba   => Some("o")
        0xbb   => Some(">>")
        0xbc   => Some("1/4")
        0xbd   => Some("1/2")
        0xbe   => Some("3/4")
        0xbf   => Some("?")
        0xc0   => Some("A")
        0xc1   => Some("A")
        0xc2   => Some("A")
        0xc3   => Some("A")
        0xc4   => Some("A")
        0xc5   => Some("Aa")
        0xc6   => Some("AE")
        0xc7   => Some("C")
        0xc8   => Some("E")
        0xc9   => Some("E")
        0xca   => Some("E")
        0xcb   => Some("E")
        0xcc   => Some("I")
        0xcd   => Some("I")
        0xce   => Some("I")
        0xcf   => Some("I")
        0xd0   => Some("D")
        0xd1   => Some("N")
        0xd2   => Some("O")
        0xd3   => Some("O")
        0xd4   => Some("O")
        0xd5   => Some("O")
        0xd6   => Some("O")
        0xd7   => Some("x")
        0xd8   => Some("Oe")
        0xd9   => Some("U")
        0xda   => Some("U")
        0xdb   => Some("U")
        0xdc   => Some("U")
        0xdd   => Some("Y")
        0xde   => Some("Th")
        0xdf   => Some("ss")
        0xe0   => Some("a")
        0xe1   => Some("a")
        0xe2   => Some("a")
        0xe3   => Some("a")
        0xe4   => Some("a")
        0xe5   => Some("aa")
        0xe6   => Some("ae")
        0xe7   => Some("c")
        0xe8   => Some("e")
        0xe9   => Some("e")
        0xea   => Some("e")
        0xeb   => Some("e")
        0xec   => Some("i")
        0xed   => Some("i")
        0xee   => Some("i")
        0xef   => Some("i")
        0xf0   => Some("d")
        0xf1   => Some("n")
        0xf2   => Some("o")
        0xf3   => Some("o")
        0xf4   => Some("o")
        0xf5   => Some("o")
        0xf6   => Some("o")
        0xf7   => Some("/")
        0xf8   => Some("oe")
        0xf9   => Some("u")
        0xfa   => Some("u")
        0xfb   => Some("u")
        0xfc   => Some("u")
        0xfd   => Some("y")
        0xfe   => Some("th")
        0xff   => Some("y")
        0x100  => Some("A")
        0x101  => Some("a")
        0x102  => Some("A")
        0x103  => Some("a")
        0x104  => Some("A")
        0x105  => Some("a")
        0x106  => Some("C")
        0x107  => Some("c")
        0x108  => Some("C")
        0x109  => Some("c")
        0x10a  => Some("C")
        0x10b  => Some("c")
        0x10c  => Some("C")
        0x10d  => Some("c")
        0x10e  => Some("D")
        0x10f  => Some("d")
        0x110  => Some("D")
        0x111  => Some("d")
        0x112  => Some("E")
        0x113  => Some("e")
        0x114  => Some("E")
        0x115  => Some("e")
        0x116  => Some("E")
        0x117  => Some("e")
        0x118  => Some("E")
        0x119  => Some("e")
        0x11a  => Some("E")
        0x11b  => Some("e")
